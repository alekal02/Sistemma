# Destino: Copy-Item env.docker.example .env
# Dev:     Copy-Item env.docker.example .env.docker

TAG=latest
REGISTRY=nexus.neurai-platform.com/docker-registry

FRONTEND_PORT=3300
BACKEND_PORT=3200
DB_PORT_EXTERNAL=5433
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9011

DB_NAME=abastecimento
DB_USER=neurai
DB_PASSWORD=neurai@2025

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=neurai@2025
MINIO_BUCKET=abastecimentos
MINIO_PUBLIC_URL=http://localhost:9002

JWT_SECRET=sistemma_jwt_local_dev_secret_32chars_min
JWT_REFRESH_SECRET=sistemma_jwt_refresh_local_dev_secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRY=30d

CORS_ORIGIN=http://localhost:3300
CORS_CREDENTIALS=true

NODE_ENV=production
LOG_LEVEL=info
SKIP_STARTUP_SEED=false
SKIP_STARTUP_MIGRATIONS=false
SYNC_KPIS_UNIVERSAIS=true

# Cache dashboard executivo (máquinas fracas — TTL 24h, aquecimento automático)
DASHBOARD_EXECUTIVO_CACHE_TTL_MS=86400000
DASHBOARD_CACHE_DISCO=true
DASHBOARD_WARMUP_ENABLED=true
DASHBOARD_WARMUP_DELAY_MS=15000
DASHBOARD_WARMUP_INTERVAL_MS=86400000

# Máquina fraca — pool PostgreSQL e concorrência
DB_POOL_MAX=8
DB_POOL_CONNECT_MS=30000
DB_STATEMENT_TIMEOUT_MS=120000
KPIS_CONSOLIDADO_CONCURRENCY=1
ENDPOINTS_PESADOS_CONCURRENCY=1
DASHBOARD_WARMUP_PAUSE_MS=2000

# Máquina fraca — acelera startup (após 1º deploy estável)
# SKIP_STARTUP_SEED=true
# SKIP_STARTUP_MIGRATIONS=true
# SYNC_KPIS_UNIVERSAIS=false
# GRAFICOS_DADOS_LIMITE=15000
# NODE_OPTIONS=--max-old-space-size=512
# DASHBOARD_WARMUP_DELAY_MS=120000
