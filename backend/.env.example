# ============================================
# SISTEMMA BACKEND — variáveis de ambiente
# ============================================
# Copie para .env e ajuste os valores.

# ─── Servidor ───
APP_PORT=3200
NODE_ENV=development
LOG_LEVEL=info
LOG_FORMAT=text

# ─── PostgreSQL ───
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=neurai
DATABASE_PASSWORD=altere_esta_senha
DATABASE_NAME=abastecimento

# ─── JWT (obrigatório em produção) ───
JWT_SECRET=sua_chave_secreta_min_32_caracteres_aqui
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=refresh_secret_super_seguro
JWT_REFRESH_EXPIRY=30d

# ─── CORS ───
CORS_ORIGIN=http://localhost:5175,http://localhost:3300
CORS_CREDENTIALS=true

# ─── MinIO ───
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=altere_esta_senha
MINIO_BUCKET=abastecimentos
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9002

# ─── OCR Python (opcional) ───
PYTHON_OCR_API_URL=http://localhost:8000
PYTHON_OCR_TIMEOUT_MS=30000

# ─── Upload ───
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# ─── LLM Providers (opcional) ───
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# LMSTUDIO_API_KEY=
