# ============================================
# SISTEMMA BACKEND — variáveis de ambiente
# ============================================
# Copie para .env e ajuste os valores.

# ─── Servidor ───
APP_PORT=3200
NODE_ENV=development
LOG_LEVEL=info
LOG_FORMAT=text

# ─── PostgreSQL ───
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=neurai
DATABASE_PASSWORD=altere_esta_senha
DATABASE_NAME=abastecimento

# ─── JWT (obrigatório em produção) ───
JWT_SECRET=sua_chave_secreta_min_32_caracteres_aqui
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=refresh_secret_super_seguro
JWT_REFRESH_EXPIRY=30d

# ─── CORS ───
CORS_ORIGIN=http://localhost:5175,http://127.0.0.1:5175,http://localhost:3300,http://127.0.0.1:3300
CORS_CREDENTIALS=true

# ─── MinIO ───
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=altere_esta_senha
MINIO_BUCKET=abastecimentos
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9002

# ─── PDF (Puppeteer) — opcional se Chrome/Edge já estiver instalado ───
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ─── OCR Python (opcional) ───
PYTHON_OCR_API_URL=http://localhost:8000
PYTHON_OCR_TIMEOUT_MS=30000

# ─── Autenticação ───
# Registro público desabilitado por padrão (somente admin pode criar usuários)
ALLOW_PUBLIC_REGISTER=false

# ─── WhatsApp (opcional) ───
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=

# ─── WuzAPI — WhatsApp via whatsmeow (planilhas de grupos) ───
# Em dev local (npm run dev): suba antes os containers:
#   docker compose up -d wuzapi-db wuzapi
# WUZAPI_URL=http://localhost:8080
# WUZAPI_TOKEN=sistemma_wuzapi_token_local
# WUZAPI_ADMIN_TOKEN=1234ABCD
# WUZAPI_WEBHOOK_URL=http://host.docker.internal:3200/api/wuzapi/webhook
# WUZAPI_WEBHOOK_SECRET=
# WUZAPI_TIMEOUT_MS=120000
# WUZAPI_INSTANCE_NAME=Sistemma

# ─── Upload ───
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# ─── Performance (Docker / máquina fraca) ───
GRAFICOS_DADOS_LIMITE=20000
DADOS_CACHE_TTL_MS=120000
DADOS_CACHE_MAX_ENTRADAS=12
KPIS_CONSOLIDADO_CONCURRENCY=2
ENDPOINTS_PESADOS_CONCURRENCY=2
PDF_CACHE_MAX_ENTRADAS=5
DB_POOL_MAX=5
NODE_OPTIONS=--max-old-space-size=768
# Após 1º deploy estável:
# SKIP_STARTUP_SEED=true
# SKIP_STARTUP_MIGRATIONS=true
# SYNC_KPIS_UNIVERSAIS=false

# ─── Cache Dashboard Executivo (máquinas fracas) ───
DASHBOARD_EXECUTIVO_CACHE_TTL_MS=86400000
DASHBOARD_CACHE_DISCO=true
DASHBOARD_WARMUP_ENABLED=true
DASHBOARD_WARMUP_DELAY_MS=45000
DASHBOARD_WARMUP_INTERVAL_MS=86400000

# ─── LLM Providers (opcional) ───
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# LMSTUDIO_API_KEY=
