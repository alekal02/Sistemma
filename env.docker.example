# Destino: Copy-Item env.docker.example .env
# Dev:     Copy-Item env.docker.example .env.docker

TAG=4.0.4
REGISTRY=nexus.neurai-platform.com/docker-registry

FRONTEND_PORT=3300
BACKEND_PORT=3200
DB_PORT_EXTERNAL=5433
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9011

DB_NAME=abastecimento
DB_USER=neurai
DB_PASSWORD=altere-sua-senha-db

# Um banco por contrato — só preencha DEPOIS do backup + migrar-bancos-por-contrato
# CONTROL_DATABASE_NAME=sistemma_control
# MULTI_TENANT=true

# Tela inicial entra sem senha (botões Gestor e Contratos).
# Só use false se quiser voltar a pedir email e senha.
ACESSO_LIVRE=true

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=altere-sua-senha-minio
MINIO_BUCKET=abastecimentos
MINIO_PUBLIC_URL=http://localhost:9002

JWT_SECRET=altere-jwt-secret-minimo-32-chars
JWT_REFRESH_SECRET=altere-jwt-refresh-secret-minimo-32
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRY=30d

CORS_ORIGIN=http://localhost:3300
CORS_CREDENTIALS=true

NODE_ENV=production
LOG_LEVEL=info
SKIP_STARTUP_SEED=false
SKIP_STARTUP_MIGRATIONS=false
SYNC_KPIS_UNIVERSAIS=true

# Cache dashboard executivo (máquinas fracas — TTL 24h, aquecimento automático)
DASHBOARD_EXECUTIVO_CACHE_TTL_MS=86400000
DASHBOARD_CACHE_DISCO=true
DASHBOARD_WARMUP_ENABLED=true
DASHBOARD_WARMUP_DELAY_MS=15000
DASHBOARD_WARMUP_INTERVAL_MS=86400000

# Máquina fraca — pool PostgreSQL e concorrência
DB_POOL_MAX=8
DB_POOL_CONNECT_MS=30000
DB_STATEMENT_TIMEOUT_MS=120000
KPIS_CONSOLIDADO_CONCURRENCY=1
ENDPOINTS_PESADOS_CONCURRENCY=1
DASHBOARD_WARMUP_PAUSE_MS=2000

# Máquina fraca — acelera startup (após 1º deploy estável)
# SKIP_STARTUP_SEED=true
# SKIP_STARTUP_MIGRATIONS=true
# SYNC_KPIS_UNIVERSAIS=false
# GRAFICOS_DADOS_LIMITE=15000
# NODE_OPTIONS=--max-old-space-size=512
# DASHBOARD_WARMUP_DELAY_MS=120000

# ─── WuzAPI (WhatsApp) — sobe AUTOMATICAMENTE no docker compose ───
# Não precisa instalar WuzAPI no Windows. URLs internas já estão no docker-compose.yml.
# Remova do .env (se existirem) linhas antigas com host.docker.internal.
WUZAPI_TOKEN=sistemma_wuzapi_token_local
WUZAPI_ADMIN_TOKEN=1234ABCD
WUZAPI_INSTANCE_NAME=Sistemma
WUZAPI_PORT=8080
WUZAPI_DB_PASSWORD=wuzapi
WUZAPI_GLOBAL_ENCRYPTION_KEY=wuzapi-sistemma-aes256-key-32ch!
WUZAPI_GLOBAL_HMAC_KEY=wuzapi-sistemma-hmac-key-min-32chars!

# Pasta na raiz do Docker (C:\Sistemma) onde o Fechar ciclo grava as planilhas.
# Fica: C:\Sistemma\planilhas-ciclo\NumeroDoContrato\25-07-2026_a_24-08-2026_Coleta.xlsx
PLANILHAS_BACKUP_HOST_DIR=./planilhas-ciclo
