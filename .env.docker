# Ambiente Docker local — gerado para build/compose (nao commitar)

REGISTRY=nexus.neurai-platform.com/docker-registry

DB_NAME=abastecimento
DB_USER=neurai
DB_PASSWORD=neurai@2025
DB_PORT_EXTERNAL=5434

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=neurai@2025
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9011
MINIO_BUCKET=abastecimentos
MINIO_PUBLIC_URL=http://localhost:9002


JWT_SECRET=sistemma_jwt_local_dev_secret_32chars_min
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=sistemma_jwt_refresh_local_dev_secret
JWT_REFRESH_EXPIRY=30d

CORS_ORIGIN=http://localhost:3300
CORS_CREDENTIALS=true

BACKEND_PORT=3201
FRONTEND_PORT=3300

MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

NODE_ENV=production
LOG_LEVEL=info
LOG_FORMAT=text

DADOS_CACHE_TTL_MS=120000
GRAFICOS_DADOS_LIMITE=50000
NODE_OPTIONS=--max-old-space-size=512
