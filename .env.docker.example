# Copie para .env.docker e ajuste conforme seu ambiente

REGISTRY=nexus.chchat.org/docker-registry
TAG=latest

DB_NAME=abastecimento
DB_USER=neurai
DB_PASSWORD=altere-a-senha
DB_PORT_EXTERNAL=5433

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=altere-a-senha
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9011
MINIO_BUCKET=abastecimentos
MINIO_PUBLIC_URL=http://localhost:9002

JWT_SECRET=altere-jwt-secret-producao
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=altere-jwt-refresh-secret
JWT_REFRESH_EXPIRY=30d

CORS_ORIGIN=http://localhost:3300
CORS_CREDENTIALS=true

BACKEND_PORT=3200
FRONTEND_PORT=3300

MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

NODE_ENV=production
LOG_LEVEL=info
LOG_FORMAT=text
