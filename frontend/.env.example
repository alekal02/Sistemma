# Frontend — copie para .env.development ou .env.local
# Dev com Vite (porta 5175): use /api — o proxy encaminha para o backend
VITE_API_URL=/api
# Alternativa direta (sem proxy): http://localhost:3200/api
VITE_APP_NAME=Sistemma
VITE_ENV=development
# Versão exibida no rodapé da aplicação (também atualizada por publicar.ps1 -Tag X.Y.Z)
# VITE_APP_VERSION=2.0.1
